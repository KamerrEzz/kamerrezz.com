---
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>OG Preview — kamerrezz.com</title>
	</head>

	<body class="bg-[#050505] text-[#FAFAFA] font-sans overflow-hidden" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.05) 1px, transparent 0); background-size: 32px 32px;">

		<div class="w-[1200px] h-[630px] border-[1.5px] border-white/10 bg-[#0A0A0A]/90 flex flex-col">

			{/* MAIN CONTENT */}
			<div class="flex-1 flex flex-col justify-center px-20">
				<div class="mb-8">
					<span class="px-3 py-1 bg-[#FAFF00] text-black shadow-[3px_3px_0_rgba(255,255,255,0.2)] font-mono text-xs font-black uppercase tracking-widest">
						kamerrezz.com
					</span>
				</div>

				<h1 class="text-7xl font-black tracking-tighter uppercase text-[#FAFAFA] leading-none">
					Te enseño lo que<br />
					aprendo mientras lo<br />
					construyo.
				</h1>

				<p class="text-xl text-zinc-400 font-light mt-8">
					Kamerr Ezz — Dev, creador de contenido, fundador de Zeew Space
				</p>
			</div>

		</div>
	</body>
</html>
